/*
 * PreoMG14Driver.rc - version information, icon and application manifest.
 *
 * The manifest is the important part: it declares asInvoker so the program
 * never asks for administrator rights just to open, and it opts into
 * per-monitor DPI awareness so the UI stays sharp on scaled displays.
 */
#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "preo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"                      /* US English, Unicode */
        BEGIN
            VALUE "CompanyName",      "Preo MG14 community"
            VALUE "FileDescription",  "Preo MG14 Driver Manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PreoMG14Driver"
            VALUE "OriginalFilename", "PreoMG14Driver.exe"
            VALUE "ProductName",      "Preo MG14 Driver Manager"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "User-mode HID mouse settings for VID_30FA&PID_0400. Installs no kernel driver."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/* RT_MANIFEST, id 1 */
1 RT_MANIFEST "app.manifest"
